def figure_panel_inputs(wildcards):
    recipe = PROJECT.recipe_config["figure_sets"][wildcards.figure_set]
    paths = []
    for panel in recipe["panels"]:
        stem = resolve_panel(PROJECT, panel).source
        paths.extend([str(stem.with_suffix(".pdf")), str(stem.with_suffix(".png"))])
    return paths

