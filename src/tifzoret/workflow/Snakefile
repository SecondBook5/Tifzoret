# Batch-corrected ordination (batch module, study-level; consumes qc's VST and
# removes analysis.batch with limma::removeBatchEffect). Opt-in, off in every
# profile; requires qc (enforced in load_project).
BATCH_OUTPUTS = [
    batch("tables/batch_corrected_expression.tsv"),
    batch("tables/batch_pca_coordinates.tsv"),
    batch("tables/batch_sample_distance.tsv"),
    batch("figures/batch_pca.pdf"),
    batch("figures/batch_pca.png"),
    batch("figures/batch_sample_distance.pdf"),
    batch("figures/batch_sample_distance.png"),
    batch("batch_summary.json"),
]

# Signature-matrix cell-fraction deconvolution (deconvolution module, study-level;
# NNLS of per-sample CPM against a user-supplied signature matrix). Opt-in, off in
# every profile; requires resources.deconvolution_signature (enforced in load_project).
DECONVOLUTION_OUTPUTS = [
    deconvolution("tables/cell_fractions.tsv"),
    deconvolution("figures/cell_fractions.pdf"),
    deconvolution("figures/cell_fractions.png"),
    deconvolution("deconvolution_summary.json"),
]

# Cross-contrast consensus (consensus module, study-level; reduces over every
# pairwise contrast's DE table). Opt-in, off in every profile; requires de and
# >=2 pairwise contrasts (enforced in load_project).
CONSENSUS_OUTPUTS = [
    comparison("tables/consensus_membership.tsv"),
    comparison("tables/consensus_genes.tsv"),
    comparison("tables/contrast_overlap.tsv"),
    comparison("tables/consensus_intersections_displayed.tsv"),
    comparison("figures/consensus_upset.pdf"),
    comparison("figures/consensus_upset.png"),
    comparison("figures/consensus_sign_heatmap.pdf"),
    comparison("figures/consensus_sign_heatmap.png"),
    comparison("consensus_summary.json"),
]

# variancePartition (variance_partition module, study-level; decomposes the QC
# VST expression into the fraction of per-gene variance attributable to each
