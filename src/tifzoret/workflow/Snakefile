from pathlib import Path
import csv
import shlex

from snakemake.utils import min_version
from tifzoret.config import load_project
from tifzoret.figures import resolve_panel

min_version("8.0")

WORKFLOW_ROOT = Path(workflow.basedir).resolve()
CONFIG_PATH = Path(workflow.configfiles[0]).resolve()
PROJECT_ROOT = CONFIG_PATH.parent

def resolve_project_path(value):
    path = Path(value).expanduser()
    return str((path if path.is_absolute() else PROJECT_ROOT / path).resolve())

PROJECT = load_project(CONFIG_PATH)
CONFIG = PROJECT.config
PROJECT_ID = PROJECT.project_id
RESULTS = PROJECT.result_root
SOURCE_FILES = [str(path) for path in PROJECT.source_files]
SOURCE_SAMPLES = str(PROJECT.samples)
INPUTS = RESULTS / "inputs"
COUNTS = str(INPUTS / "counts.tsv")
SAMPLES = str(INPUTS / "samples.tsv")
ANNOTATION = str(INPUTS / "annotation.tsv")
INPUT_MANIFEST = str(INPUTS / "input_manifest.json")
SOURCE_CONTRASTS = str(PROJECT.contrasts)
CONTRASTS = str(INPUTS / "contrasts.tsv")
# Companion documents (hypotheses/panels/recipe) may be authored as sibling files
# or inlined in the main config; either way load_project points these at their
# canonical INPUTS location and materialize_inputs stages the resolved document
# there, so every downstream rule consumes str(PROJECT.*) from one place.
PANELS = str(PROJECT.hypothesis_panels) if PROJECT.hypothesis_panels else None
CLAIMS = str(PROJECT.hypotheses) if PROJECT.hypotheses else None
RECIPE = str(PROJECT.figure_recipe) if PROJECT.figure_recipe else None
COMPANION_OUTPUTS = {
    name: value
    for name, value in (("panels", PANELS), ("claims", CLAIMS), ("recipe", RECIPE))
    if value
}
COMPANION_ARGS = " ".join(
    f"--{name} {shlex.quote(value)}" for name, value in COMPANION_OUTPUTS.items()
)
# TPM/FPKM abundances are derived from the featureCounts exon-union Length column,
# so they exist only when counting runs; a precomputed count matrix ships no
# per-gene exon lengths. Declared (and requested) only for non-counts sources.
ABUNDANCE_OUTPUTS = (
    {
        "tpm": str(INPUTS / "tpm.tsv"),
        "fpkm": str(INPUTS / "fpkm.tsv"),
        "gene_lengths": str(INPUTS / "gene_lengths.tsv"),
    }
    if PROJECT.source_kind != "counts"
    else {}
)
ABUNDANCE_ARGS = " ".join(
    f"--{name.replace('_', '-')} {shlex.quote(value)}"
    for name, value in ABUNDANCE_OUTPUTS.items()
)
CUSTOM_GMT = str(PROJECT.gmt)
RESOURCE_CACHE = RESULTS / ".cache" / "resources"
GMT = str(RESOURCE_CACHE / "gene_sets.gmt")
RESOURCE_TABLE = str(RESOURCE_CACHE / "gene_sets.tsv")
RESOURCE_RECEIPT = str(RESOURCE_CACHE / "gene_sets.receipt.json")
MODULES = {
    name: name in PROJECT.modules
    for name in (
        "qc", "de", "pathways", "ontology", "composition", "regulators",
        "networks", "hypotheses", "publication", "report", "sva", "wgcna",
        "mediation", "multilayer",
        # Opt-in modules (off in every profile; enabled via analysis.modules).
        "batch", "de_confirm", "deconvolution", "curvature",
        "consensus", "spia", "variance_partition", "enrichment_map",
    )
}

with open(SOURCE_CONTRASTS, newline="") as handle:
    CONTRAST_ROWS = list(csv.DictReader(handle, delimiter="\t"))
CONTRAST_IDS = [row["contrast_id"] for row in CONTRAST_ROWS]
# DE and pathways understand both pairwise and coefficient (difference-in-
# differences) contrasts. The remaining per-contrast modules assume a two-group
# design and would mis-specify or fail on a coefficient contrast, so they expand
# over pairwise contrasts only. A row is pairwise when its optional `type` column
# is absent, empty, or the literal "pairwise" (every row in a pairwise-only study).
PAIRWISE_CONTRAST_IDS = [
    row["contrast_id"]
    for row in CONTRAST_ROWS
    if (row.get("type") or "pairwise").strip().lower() == "pairwise"
]
# Signed contrasts (pairwise + coefficient) produce a directional effect and run
# through contrast_de + pathways. Omnibus (LRT) contrasts have no signed effect,
# so they run through contrast_omnibus instead. With no omnibus rows present,
# SIGNED_CONTRAST_IDS == CONTRAST_IDS, so pairwise-only studies are unchanged.
SIGNED_CONTRAST_IDS = [
    row["contrast_id"]
    for row in CONTRAST_ROWS
    if (row.get("type") or "pairwise").strip().lower() in ("pairwise", "coefficient")
]
OMNIBUS_CONTRAST_IDS = [
    row["contrast_id"]
    for row in CONTRAST_ROWS
    if (row.get("type") or "pairwise").strip().lower() == "omnibus"
]

R_ENV = str(WORKFLOW_ROOT / "envs" / "r.yaml")
CORE_ENV = str(WORKFLOW_ROOT / "envs" / "core.yaml")
NETWORK_ENV = str(WORKFLOW_ROOT / "envs" / "network.yaml")
UTILS_R = str(WORKFLOW_ROOT / "scripts" / "utils.R")

def qc(path):
    return str(RESULTS / "qc" / path)

def batch(path):
    return str(RESULTS / "batch" / path)

def deconvolution(path):
    return str(RESULTS / "deconvolution" / path)

def comparison(path):
    return str(RESULTS / "comparison" / path)

def variance_partition(path):
    return str(RESULTS / "variance_partition" / path)

def contrast(path):
    return str(RESULTS / "contrasts" / "{contrast_id}" / path)

def analysis(module, path):
    return contrast(str(Path("analyses") / module / path))

