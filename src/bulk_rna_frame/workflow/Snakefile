    FINAL_OUTPUTS.extend(expand(ONTOLOGY_PATTERNS, contrast_id=PAIRWISE_CONTRAST_IDS))
if MODULES["composition"]:
    FINAL_OUTPUTS.extend(expand(COMPOSITION_PATTERNS, contrast_id=PAIRWISE_CONTRAST_IDS))
