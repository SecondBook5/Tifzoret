from pathlib import Path
import csv

from snakemake.utils import min_version
from bulk_rna_frame.config import load_project

min_version("8.0")

WORKFLOW_ROOT = Path(workflow.basedir).resolve()
CONFIG_PATH = Path(workflow.configfiles[0]).resolve()
PROJECT_ROOT = CONFIG_PATH.parent

def resolve_project_path(value):
    path = Path(value).expanduser()
    return str((path if path.is_absolute() else PROJECT_ROOT / path).resolve())

PROJECT_ID = config["project"]["id"]
RESULTS = Path(resolve_project_path(config["output"]["root"])) / PROJECT_ID
PROJECT = load_project(CONFIG_PATH)
SOURCE_FILES = [str(path) for path in PROJECT.source_files]
SOURCE_SAMPLES = str(PROJECT.samples)
INPUTS = RESULTS / "inputs"
COUNTS = str(INPUTS / "counts.tsv")
SAMPLES = str(INPUTS / "samples.tsv")
ANNOTATION = str(INPUTS / "annotation.tsv")
INPUT_MANIFEST = str(INPUTS / "input_manifest.json")
CONTRASTS = resolve_project_path(config["contrasts"])
GMT = resolve_project_path(config["gene_sets"]["gmt"])
MODULES = config["modules"]

with open(CONTRASTS, newline="") as handle:
    CONTRAST_ROWS = list(csv.DictReader(handle, delimiter="\t"))
CONTRAST_IDS = [row["contrast_id"] for row in CONTRAST_ROWS]

R_ENV = str(WORKFLOW_ROOT / "envs" / "r.yaml")
CORE_ENV = str(WORKFLOW_ROOT / "envs" / "core.yaml")
UTILS_R = str(WORKFLOW_ROOT / "scripts" / "utils.R")

def qc(path):
    return str(RESULTS / "qc" / path)

def contrast(path):
    return str(RESULTS / "contrasts" / "{contrast_id}" / path)

QC_OUTPUTS = [
    qc("objects/vst.rds"),
    qc("tables/vst_expression.tsv"),
    qc("tables/pca_coordinates.tsv"),
    qc("tables/pca_variance.tsv"),
    qc("tables/sample_correlation.tsv"),
    qc("figures/pca.pdf"),
    qc("figures/pca.png"),
    qc("figures/sample_correlation.pdf"),
    qc("figures/sample_correlation.png"),
    qc("qc_summary.json"),
]

DE_PATTERNS = [
    contrast("objects/deseq2.rds"),
    contrast("tables/de_results.tsv"),
    contrast("tables/volcano_displayed.tsv"),
    contrast("tables/de_heatmap_displayed.tsv"),
    contrast("figures/volcano.pdf"),
    contrast("figures/volcano.png"),
    contrast("figures/de_heatmap.pdf"),
    contrast("figures/de_heatmap.png"),
    contrast("de_summary.json"),
]

PATHWAY_PATTERNS = [
    contrast("tables/fgsea.tsv"),
    contrast("tables/ora.tsv"),
    contrast("tables/ora_displayed.tsv"),
    contrast("tables/gsva_scores.tsv"),
    contrast("tables/gsva_differential.tsv"),
    contrast("tables/gsva_heatmap_displayed.tsv"),
    contrast("tables/gsea_curves_displayed.tsv"),
    contrast("figures/ora_bidirectional.pdf"),
    contrast("figures/ora_bidirectional.png"),
    contrast("figures/gsva_heatmap.pdf"),
    contrast("figures/gsva_heatmap.png"),
    contrast("figures/gsea_curves.pdf"),
    contrast("figures/gsea_curves.png"),
    contrast("pathways_summary.json"),
]

CANONICAL_INPUTS = [COUNTS, SAMPLES, ANNOTATION, INPUT_MANIFEST]
FINAL_OUTPUTS = list(CANONICAL_INPUTS)
if MODULES["qc"]:
    FINAL_OUTPUTS.extend(QC_OUTPUTS)
if MODULES["de"]:
    FINAL_OUTPUTS.extend(expand(DE_PATTERNS, contrast_id=CONTRAST_IDS))
if MODULES["pathways"]:
    FINAL_OUTPUTS.extend(expand(PATHWAY_PATTERNS, contrast_id=CONTRAST_IDS))

localrules: all

rule all:
    input:
        str(RESULTS / "manifest.json")

rule materialize_inputs:
    input:
        sources=SOURCE_FILES,
        samples=SOURCE_SAMPLES,
        config=str(CONFIG_PATH),
        script=str(WORKFLOW_ROOT / "scripts" / "materialize_inputs.py")
    output:
        counts=COUNTS,
        samples=SAMPLES,
        annotation=ANNOTATION,
        manifest=INPUT_MANIFEST
    log:
        str(INPUTS / "materialize.log")
    threads:
        config.get("counting", {}).get("threads", 1)
    conda:
        CORE_ENV
    shell:
        "python {input.script} --project-config {input.config:q} --counts {output.counts:q} "
        "--samples {output.samples:q} --annotation {output.annotation:q} "
        "--manifest {output.manifest:q} --threads {threads} > {log:q} 2>&1"

rule study_qc:
    input:
        counts=COUNTS,
        samples=SAMPLES,
        annotation=ANNOTATION,
        config=str(CONFIG_PATH),
        script=str(WORKFLOW_ROOT / "scripts" / "qc.R"),
        utils=UTILS_R
    output:
        vst=qc("objects/vst.rds"),
        expression=qc("tables/vst_expression.tsv"),
        pca_coordinates=qc("tables/pca_coordinates.tsv"),
        pca_variance=qc("tables/pca_variance.tsv"),
        correlation=qc("tables/sample_correlation.tsv"),
        pca_pdf=qc("figures/pca.pdf"),
        pca_png=qc("figures/pca.png"),
        correlation_pdf=qc("figures/sample_correlation.pdf"),
        correlation_png=qc("figures/sample_correlation.png"),
        summary=qc("qc_summary.json")
    log:
        qc("logs/qc.log")
    conda:
        R_ENV
    shell:
        "Rscript --vanilla {input.script} --project-config {input.config:q} "
        "--counts {input.counts:q} --samples {input.samples:q} --annotation {input.annotation:q} "
        "--outdir {RESULTS}/qc > {log:q} 2>&1"

rule contrast_de:
    input:
        counts=COUNTS,
        samples=SAMPLES,
        annotation=ANNOTATION,
        contrasts=CONTRASTS,
        config=str(CONFIG_PATH),
        script=str(WORKFLOW_ROOT / "scripts" / "de.R"),
        utils=UTILS_R
    output:
        dds=contrast("objects/deseq2.rds"),
        results=contrast("tables/de_results.tsv"),
        volcano_table=contrast("tables/volcano_displayed.tsv"),
        heatmap_table=contrast("tables/de_heatmap_displayed.tsv"),
        volcano_pdf=contrast("figures/volcano.pdf"),
        volcano_png=contrast("figures/volcano.png"),
        heatmap_pdf=contrast("figures/de_heatmap.pdf"),
        heatmap_png=contrast("figures/de_heatmap.png"),
        summary=contrast("de_summary.json")
    log:
        contrast("logs/de.log")
    conda:
        R_ENV
    shell:
        "Rscript --vanilla {input.script} --project-config {input.config:q} "
        "--counts {input.counts:q} --samples {input.samples:q} --annotation {input.annotation:q} "
        "--contrasts {input.contrasts:q} "
        "--contrast-id {wildcards.contrast_id:q} "
        "--outdir {RESULTS}/contrasts/{wildcards.contrast_id} > {log:q} 2>&1"

rule contrast_pathways:
    input:
        de=contrast("tables/de_results.tsv"),
        vst=qc("objects/vst.rds"),
        samples=SAMPLES,
        annotation=ANNOTATION,
        gmt=GMT,
        config=str(CONFIG_PATH),
        contrasts=CONTRASTS,
        script=str(WORKFLOW_ROOT / "scripts" / "pathways.R"),
        utils=UTILS_R
    output:
        fgsea=contrast("tables/fgsea.tsv"),
        ora=contrast("tables/ora.tsv"),
        ora_displayed=contrast("tables/ora_displayed.tsv"),
        gsva_scores=contrast("tables/gsva_scores.tsv"),
        gsva_differential=contrast("tables/gsva_differential.tsv"),
        gsva_displayed=contrast("tables/gsva_heatmap_displayed.tsv"),
        gsea_displayed=contrast("tables/gsea_curves_displayed.tsv"),
        ora_pdf=contrast("figures/ora_bidirectional.pdf"),
        ora_png=contrast("figures/ora_bidirectional.png"),
        gsva_pdf=contrast("figures/gsva_heatmap.pdf"),
        gsva_png=contrast("figures/gsva_heatmap.png"),
        gsea_pdf=contrast("figures/gsea_curves.pdf"),
        gsea_png=contrast("figures/gsea_curves.png"),
        summary=contrast("pathways_summary.json")
    log:
        contrast("logs/pathways.log")
    conda:
        R_ENV
    shell:
        "Rscript --vanilla {input.script} --project-config {input.config:q} "
        "--samples {input.samples:q} --annotation {input.annotation:q} "
        "--contrasts {input.contrasts:q} --gmt {input.gmt:q} "
        "--contrast-id {wildcards.contrast_id:q} --vst {input.vst:q} --de {input.de:q} "
        "--outdir {RESULTS}/contrasts/{wildcards.contrast_id} > {log:q} 2>&1"

rule release_manifest:
    input:
        artifacts=FINAL_OUTPUTS,
        config=str(CONFIG_PATH),
        script=str(WORKFLOW_ROOT / "scripts" / "manifest.py")
    output:
        str(RESULTS / "manifest.json")
    log:
        str(RESULTS / "manifest.log")
    params:
        results=str(RESULTS)
    conda:
        CORE_ENV
    shell:
        "python {input.script} --project-config {input.config:q} --results {params.results:q} --output {output:q} > {log:q} 2>&1"
