Bootstrap: docker
From: mambaorg/micromamba:2.3.2

%files
    . /opt/bulk-rna-frame

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    cd /opt/bulk-rna-frame
    micromamba install --yes --name base --file environment.yaml
    micromamba clean --all --yes

%labels
    org.opencontainers.image.title BulkRNAFrame
    org.opencontainers.image.licenses MIT

%runscript
    export PATH=/opt/conda/bin:$PATH
    exec bulk-rna "$@"
